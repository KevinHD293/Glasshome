<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- ==================== WIDGET LỊCH ÂM DƯƠNG ==================== -->
    <LinearLayout
        android:id="@+id/widget_calendar_root"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_widget_month_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tháng 10"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Hàng tiêu đề các thứ trong tuần -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T2" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T3" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T4" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T5" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T6" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T7" android:textColor="#B0BEC5" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="CN" android:textColor="#B0BEC5" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Lưới lịch mini hiển thị các ngày -->
        <GridLayout
            android:id="@+id/grid_calendar_days"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:columnCount="7"
            android:rowCount="5" />
    </LinearLayout>

    <!-- ==================== WIDGET THỜI TIẾT ==================== -->
    <LinearLayout
        android:id="@+id/widget_weather_root"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img_widget_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Weather Icon" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Thời tiết"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_location_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vũ Quang · cập nhật 17:12"
            android:textColor="#B0BEC5"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_widget_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ít mây"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_widget_weather_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cảm giác 30° · Độ ẩm 94%&#10;Cao 29° · Thấp 23° · Mưa 100%"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="#FFFFFF"
                android:textSize="46sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
